version: "3.8"
services:
  pockerplanner:
    image: {{ planner_image | to_json }}
    environment:
      POCKETHIVE_AUTH_BASE_URL: {{ planner_auth_base | to_json }}
    ports:
      - target: 8765
        published: {{ planner_port | int }}
        protocol: tcp
        mode: ingress
    volumes:
      - type: bind
        source: {{ (planner_bind_root + '/state/pockerplanner') | to_json }}
        target: /data
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
    deploy:
      replicas: 1
      placement:
        constraints:
          - {{ ('node.hostname == ' + planner_node) | to_json }}
      update_config:
        order: stop-first
      restart_policy:
        condition: any
